# Mirror of backend/.dev.vars — copy this file to .env and fill in values.
# The Cloudflare Worker reads secrets from backend/.dev.vars (same keys), NOT from this file.

# Turso database (https://turso.tech -> Create database -> copy the URLs)
TURSO_DATABASE_URL="libsql://your-db.region.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Used to sign session JWTs (any long random string, e.g. openssl rand -base64 32)
JWT_SECRET="replace-me-with-a-long-random-string"

# OpenAI-compatible LLM (optional until you set these; summarize returns 422 without)
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="sk-..."

# Apify API token (required) — used to fetch YouTube transcripts via the
# youtube-transcript-api actor (om_kh~youtube-transcript-api).
APIFY_API_TOKEN="apify_api_..."

# OAuth (optional; only needed for "Continue with Google / GitHub")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
