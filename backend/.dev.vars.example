# Local Cloudflare Worker secrets template
# Copy to backend/.dev.vars and fill in your actual credentials.
# NEVER commit your actual .dev.vars file.

TURSO_DATABASE_URL="libsql://your-db.region.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
LLM_API_KEY="sk-..."
APIFY_API_TOKEN="apify_api_..."

# Optional OAuth credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
